# Copy to .env (project root) and fill in. Never commit .env.

ENV=dev

# PostgreSQL (docker compose: 127.0.0.1:5442)
DATABASE_URL=postgresql+asyncpg://zama:zama@localhost:5442/zama
TEST_DATABASE_URL=postgresql+asyncpg://zama:zama@localhost:5442/zama_test

# Vercel AI Gateway: one key for LLM (OpenAI) and Jev
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
JEV_MODEL=typesafe-ai/jev
# asks Vercel not to store the request texts. Vercel accepts it only on the Pro and
# Enterprise plans: on hobby every Jev request is rejected with 403, so set it to false there
JEV_ZERO_DATA_RETENTION=true

# Encryption key for channel tokens and endpoint secrets (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Public URLs
PUBLIC_API_URL=http://localhost:8090
ADMIN_URL=http://localhost:3120

# Admin login: Google OAuth (stage 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic link e-mail (stage 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Zama Chat
SMTP_USE_TLS=true
# dev only: return the magic link in the API response and log it
MAGIC_LINK_DEV_ECHO=true

# Instagram (stage 4) — one Meta app for the whole system.
# "Instagram API with Instagram Login": take the Instagram app ID / secret from
# App Dashboard → Instagram → API setup with Instagram login.
# Webhook URL for the app: $PUBLIC_API_URL/v1/channels/instagram/webhook
# OAuth redirect URI:      $ADMIN_URL/api/v1/admin/channels/instagram/callback
META_APP_ID=
META_APP_SECRET=
# any random string; the same value goes to the webhook settings of the Meta app
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_URL=https://graph.instagram.com/v23.0
IG_OAUTH_URL=https://www.instagram.com/oauth/authorize
IG_TOKEN_URL=https://api.instagram.com/oauth/access_token
# operator replies up to 7 days after the client's message (needs Meta's Human Agent
# permission)
IG_HUMAN_AGENT_TAG=false

# Notifications (stage 4): Telegram bot tokens and chat ids are set per notifier in the
# admin (stored encrypted); e-mail notifications use the SMTP settings above
TELEGRAM_API_URL=https://api.telegram.org

# Search (stage 5): docker compose starts both (make up). An empty URL switches that
# index off: the bot then searches with the other one only.
# Elasticsearch — the catalog by words (uk / ru / en word forms, typos, filters)
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
# Qdrant — the catalog and the knowledge base by meaning (embeddings of the LLM role
# "embed", e.g. openai/text-embedding-3-large added in the admin → Models)
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
SEARCH_INDEX_PREFIX=zama_

# Receipts (stage 6): the vision model is the LLM role "vision" (a model with images,
# assigned in the admin → Models). The bot downloads the image the client sent.
RECEIPT_MAX_MB=10
# never true in production: lets the bot download from private / local addresses
RECEIPT_FETCH_PRIVATE=false
# The CRM sends booking outcomes to POST /v1/events (signed with the endpoint's secret,
# or with an API key) — see docs/07-stage6-booking.md
