# Copy to .env (project root) and fill in. Never commit .env.

ENV=dev

# PostgreSQL (docker compose: 127.0.0.1:5442)
DATABASE_URL=postgresql+asyncpg://zama:zama@localhost:5442/zama
TEST_DATABASE_URL=postgresql+asyncpg://zama:zama@localhost:5442/zama_test

# Vercel AI Gateway: one key for LLM (OpenAI) and Jev
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
JEV_MODEL=typesafe-ai/jev
JEV_ZERO_DATA_RETENTION=true

# Encryption key for channel tokens and endpoint secrets (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Public URLs
PUBLIC_API_URL=http://localhost:8090
ADMIN_URL=http://localhost:3120

# Admin login: Google OAuth (stage 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic link e-mail (stage 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Zama Chat
SMTP_USE_TLS=true
# dev only: return the magic link in the API response and log it
MAGIC_LINK_DEV_ECHO=true

# Instagram (stage 4) — one Meta app for the whole system
META_APP_ID=
META_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_URL=https://graph.instagram.com/v23.0

# Search (stage 5)
ELASTICSEARCH_URL=http://localhost:9201
QDRANT_URL=http://localhost:6334
